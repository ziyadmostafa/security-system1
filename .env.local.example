# Local Development Environment Variables
# Copy this file to .env.local and update values as needed

# Backend API URLs
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080

# Ngrok Tunnel URLs (for production/Vercel)
NEXT_PUBLIC_NGROK_URL=https://spireless-elmira-unmurmurously.ngrok-free.dev

# Environment detection
NODE_ENV=development

# WebSocket Configuration
NEXT_PUBLIC_WS_TRANSPORTS=websocket
NEXT_PUBLIC_WS_RECONNECT=true
NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_WS_RECONNECT_DELAY=1000

# Debug Mode
NEXT_PUBLIC_DEBUG=true
