# Production Environment Variables (Vercel)
# These will be automatically set on Vercel

# Backend API URLs (ngrok tunnel)
NEXT_PUBLIC_API_URL=https://spireless-elmira-unmurmurously.ngrok-free.dev
NEXT_PUBLIC_WS_URL=https://spireless-elmira-unmurmurably.ngrok-free.dev

# Environment detection
NODE_ENV=production

# WebSocket Configuration
NEXT_PUBLIC_WS_TRANSPORTS=websocket
NEXT_PUBLIC_WS_RECONNECT=true
NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=10
NEXT_PUBLIC_WS_RECONNECT_DELAY=2000

# Debug Mode (disabled in production)
NEXT_PUBLIC_DEBUG=false
